@page "/Map"

@using PedalLib.Util
@using BlazorBootstrap

@inject DataService DataService

<GoogleMap ApiKey="@ApiKey"
           Center="new GoogleMapCenter(DataService.StationInfoList.First().lat, DataService.StationInfoList.First().lon)"
           Height="800"
           Width="100"
           Zoom="15"
           Markers="markers"/>
@code {
    public string ApiKey = "AIzaSyCyyBPxcbDSn1g64Ls9q1llw51ZSBisu_Y";
    public List<GoogleMapMarker> markers;

    protected override void OnInitialized()
    {
        markers = new();

        foreach (var station in DataService.StationInfoList)
        {
            var marker = new GoogleMapMarker
            {
                Position = new GoogleMapMarkerPosition(station.lat, station.lon),
                Title = station.name,
            };
            markers.Add(marker);
        }
    }

}
