<MudGrid>
    @foreach (var station in stationList)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard>
                <MudCardContent>
                    <h4>@ds.GetStationInfoById(@station.station_id).name</h4>
                    <p><strong>distance:</strong> @station.LocationFromMe</p>
                    <p><strong>score:</strong> @station.DocDesperationScore</p>
                    <p><strong><MudLink Href=@ds.GetStationInfoById(@station.station_id).GoogleMapsUrl>Maps link</MudLink></strong></p>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>



@code {
    string locationInfo;
    StationInfoModel station;
    List<StationStatusModel> stationList;
    protected override async Task OnInitializedAsync()
    {
        if (ds.StationStatusList == null)
        {
            stationList = new List<StationStatusModel>();
            stationList.Add(new StationStatusModel());
        }
        else
        {
            stationList = ds.StationStatusList.OrderByDescending(s => s.DocDesperationScore).ToList();
        }
    }

    async Task GetLocation()
    {
        var loc = await Geolocation.GetLocationAsync();

        ds.Longitude = loc.Longitude;
        ds.Latitude = loc.Latitude;
        locationInfo = $"Lat: {loc?.Latitude}, Lon: {loc?.Longitude} acracy:{loc?.Accuracy}";
    }

    private async Task GetNearestDockInNeed()
    {
        try
        {
            await GetLocation();
            ds.UpdateStationInfo();
            ds.UpdateStationStatus();
            ds.CalculateDocLocationFromMe();

            stationList = ds.StationStatusList.OrderByDescending(s => s.DocDesperationScore).ToList();
            station = ds.GetStationInfoById(stationList.FirstOrDefault().station_id);
            locationInfo = $"Nearest Dock in need: {station?.station_id} at Lat: {station?.lat}, Lon: {station?.lon}";
        }
        catch (Exception exp)
        {
            Console.WriteLine(exp.ToString());
        }

    }

    private async Task GetNearestDockInToLoose()
    {
        await GetLocation();
        ds.UpdateStationInfo();
        ds.UpdateStationStatus();
        ds.CalculateDocLocationFromMe();

        stationList = ds.StationStatusList.OrderBy(s => s.DocDesperationScore).ToList();
        station = ds.GetStationInfoById(stationList.FirstOrDefault().station_id);
        locationInfo = $"Nearest Dock in to loose: {station?.station_id} at Lat: {station?.lat}, Lon: {station?.lon}";
    }
}
