@page "/"  
@using MudBlazor  
@using PedalLib.Model  
@using PedalLib.Util  
@using System.Threading.Tasks

@inject DataService ds

<MudButton @onclick="GetLocation">Get Location</MudButton>

<MudButton @onclick="GetNearestDockInNeed">Nearest Dock in need</MudButton>
<MudButton @onclick="GetNearestDockInToLoose">Nearest Dock with surplus</MudButton>

<p>@locationInfo</p>

<MudCard>
    <MudCardContent>
        <h4>@station?.name</h4>
        <p><strong>Active</strong> @ds.GetStationStatusById(station?.station_id)?.is_renting</p>
        <p><strong>Station ID:</strong> @station?.station_id</p>
        <p><strong>Latitude:</strong> @station?.lat</p>
        <p><strong>Longitude:</strong> @station?.lon</p>
        <p><strong>Capacity:</strong> @station?.capacity</p>
        <p><strong>Available:</strong> @ds.GetStationStatusById(station?.station_id)?.num_bikes_available</p>
        <p><strong>Desperation score:</strong> @ds.GetStationStatusById(station?.station_id)?.DocDesperationScore</p>
        <p><strong><MudLink Href=@station?.GoogleMapsUrl>Maps link</MudLink></strong></p>
    </MudCardContent>
</MudCard>

